# Development-only Azure Speech credentials. Never use VITE_ prefixes.
# Prefer the hidden PowerShell prompt documented in README.md.
# The generator reads process environment variables; it does not auto-load .env.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Deployment policy. Default private: no hosted MP3s; IndexedDB ZIP still works.
# Set public in the build environment ONLY with a verified publication record.
SONIA_AUDIO_MODE=private
