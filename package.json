{
  "name": "an-tam-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-audio.mjs",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "audio:generate": "node scripts/generate-sonia.mjs",
    "audio:plan": "node scripts/generate-sonia.mjs --dry-run",
    "audio:scan": "node scripts/prepare-audio.mjs",
    "audio:check": "node scripts/prepare-audio.mjs --require-complete"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "mpg123-decoder": "^1.0.3",
    "vite": "^7.2.2"
  }
